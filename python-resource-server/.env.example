# --- Resource server ---
VAULT_PATH=/home/nzrtnetw/vault
PRICE_PER_REQUEST=$0.001
EVM_ADDRESS=0x...              # receiving wallet (payTo)

# --- Facilitator: testnet (default) ---
# Public x402.org facilitator, Base Sepolia, no auth.
FACILITATOR_URL=https://x402.org/facilitator
NETWORK=eip155:84532

# --- Facilitator: Base mainnet (Coinbase CDP, x402 v2) ---
# When CDP_API_KEY_ID/SECRET are set the middleware routes verify/settle through the
# CDP facilitator (URL auto-set) with a signed Ed25519 JWT; FACILITATOR_URL above is
# ignored. Set NETWORK=eip155:8453 and EVM_ADDRESS to the Base-mainnet receiving address.
# NETWORK=eip155:8453
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
